{
  "id": null,
  "uid": "telecom-monitoring-main",
  "title": "Telecom Network Monitoring",
  "tags": [
    "telecom",
    "monitoring"
  ],
  "style": "dark",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "\ud83d\udcca Network Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Network Events",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "TelecomPostgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TelecomPostgres"
          },
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM raw_network_events;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Devices (5 min)",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "TelecomPostgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TelecomPostgres"
          },
          "format": "table",
          "rawSql": "SELECT COUNT(DISTINCT device_id) AS value FROM raw_network_events WHERE event_timestamp > now() - interval '5 minutes';",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "green",
                "value": 24
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Device Failures (1h)",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "TelecomPostgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TelecomPostgres"
          },
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM raw_network_events WHERE status = 'DOWN' AND event_timestamp > now() - interval '1 hour';",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total Alerts (24h)",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "TelecomPostgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TelecomPostgres"
          },
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM alerts WHERE alert_timestamp > now() - interval '24 hours';",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "\ud83e\ude7a Device Health",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Avg CPU Utilization (now)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "TelecomPostgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TelecomPostgres"
          },
          "format": "table",
          "rawSql": "SELECT AVG(cpu_usage) AS value FROM raw_network_events WHERE event_timestamp > now() - interval '5 minutes';",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "Avg Memory Utilization (now)",
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "TelecomPostgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TelecomPostgres"
          },
          "format": "table",
          "rawSql": "SELECT AVG(memory_usage) AS value FROM raw_network_events WHERE event_timestamp > now() - interval '5 minutes';",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU & Memory Trend (1-min avg)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "TelecomPostgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TelecomPostgres"
          },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(event_timestamp, '1m') AS time, AVG(cpu_usage) AS cpu_usage, AVG(memory_usage) AS memory_usage FROM raw_network_events WHERE $__timeFilter(event_timestamp) GROUP BY 1 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "spanNulls": true,
            "pointSize": 4,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Packet Loss Trend (1-min avg)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "TelecomPostgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TelecomPostgres"
          },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(event_timestamp, '1m') AS time, AVG(packet_loss) AS packet_loss FROM raw_network_events WHERE $__timeFilter(event_timestamp) GROUP BY 1 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "spanNulls": true,
            "pointSize": 4,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "\u26a0\ufe0f High Latency Devices (> 200ms, last hour)",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "TelecomPostgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TelecomPostgres"
          },
          "format": "table",
          "rawSql": "SELECT device_id, device_type, region, latency_ms, event_timestamp FROM raw_network_events WHERE latency_ms > 200 AND event_timestamp > now() - interval '1 hour' ORDER BY event_timestamp DESC LIMIT 50;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 200
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "\ud83d\udea8 Alerts",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "type": "piechart",
      "title": "Alerts by Severity",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "TelecomPostgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TelecomPostgres"
          },
          "format": "table",
          "rawSql": "SELECT severity, COUNT(*) AS count FROM alerts GROUP BY severity ORDER BY count DESC;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CRITICAL"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HIGH"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "MEDIUM"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 14,
      "type": "barchart",
      "title": "Alerts by Region",
      "gridPos": {
        "x": 8,
        "y": 25,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "TelecomPostgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TelecomPostgres"
          },
          "format": "table",
          "rawSql": "SELECT region, COUNT(*) AS count FROM alerts GROUP BY region ORDER BY count DESC;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "showValue": "always"
      }
    },
    {
      "id": 15,
      "type": "barchart",
      "title": "Top Devices by Alert Count",
      "gridPos": {
        "x": 16,
        "y": 25,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "TelecomPostgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TelecomPostgres"
          },
          "format": "table",
          "rawSql": "SELECT device_id, COUNT(*) AS count FROM alerts GROUP BY device_id ORDER BY count DESC LIMIT 10;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "showValue": "always"
      }
    }
  ]

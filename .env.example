# =============================================================================
# انسخ الملف ده باسم .env قبل تشغيل docker compose up
# cp .env.example .env
# =============================================================================

# --- Application PostgreSQL (raw/processed events, alerts, devices) ---
APP_DB_USER=telecom_admin
APP_DB_PASSWORD=1
APP_DB_NAME=telecom_monitoring

# --- Airflow Metadata PostgreSQL (منفصلة تماماً عن بيانات المشروع) ---
AIRFLOW_DB_USER=airflow_admin
AIRFLOW_DB_PASSWORD=1
AIRFLOW_DB_NAME=airflow_metadata

# --- Airflow Web UI Admin User ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=1

# --- Grafana Admin User ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=1

# --- Kafka (للاستخدام من سكربتات Python خارج/داخل الـ containers) ---
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:29092
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:9092

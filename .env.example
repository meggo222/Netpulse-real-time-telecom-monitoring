

# --- Application PostgreSQL (raw/processed events, alerts, devices) ---
APP_DB_USER=USER
APP_DB_PASSWORD=your_password
APP_DB_NAME=NAME

# --- Airflow Metadata PostgreSQL (منفصلة تماماً عن بيانات المشروع) ---
AIRFLOW_DB_USER=USER
AIRFLOW_DB_PASSWORD=your_password
AIRFLOW_DB_NAME=NAME

# --- Airflow Web UI Admin User ---
AIRFLOW_ADMIN_USER=USER
AIRFLOW_ADMIN_PASSWORD=your_password

# --- Grafana Admin User ---
GRAFANA_ADMIN_USER=USER
GRAFANA_ADMIN_PASSWORD=your_password

# --- Kafka (للاستخدام من سكربتات Python خارج/داخل الـ containers) ---
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:29092
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:9092
